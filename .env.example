# =========================================
#  ENSPY Platform — Variables d'environnement
# =========================================

# Mot de passe PostgreSQL (choisissez un mot de passe fort)
POSTGRES_PASSWORD=remplacez_par_un_mot_de_passe_fort_et_unique

# Clé secrète JWT (générez avec : openssl rand -hex 32)
JWT_SECRET=remplacez_par_une_cle_aleatoire_d_au_moins_64_caracteres

# DATABASE_URL (construite automatiquement par Docker Compose)
# Si vous déployez sans Docker, utilisez :
# DATABASE_URL=postgresql://enspy:POSTGRES_PASSWORD@localhost:5432/enspy

# Dossier persistant des documents téléversés (géré par Docker)
UPLOAD_DIR=/app/uploads

# URL publique à utiliser dans l'application Android après le déploiement.
# Exemple : https://api.enspy.cm
PUBLIC_API_URL=https://votre-domaine.example

# Sécurité / anti-abus
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=15

# Redis optionnel (profil Docker "cache")
# REDIS_URL=redis://redis:6379

# Installateur VPS : 1 = prend possession des ports 80/443 (défaut), 0 = non destructif
# ENSPY_FORCE_PORTS=1
